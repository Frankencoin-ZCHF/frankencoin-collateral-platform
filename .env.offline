# Offline / test environment — `yarn dev:offline` (astro dev --mode offline).
# Assessments come from a local git clone (tree, files, full version history via git);
# protocol data comes from the JSON fixtures. GITHUB_TOKEN from .env still applies: discussions are
# attempted with a short timeout and degrade cleanly when there is no connectivity.
ASSESSMENTS_LOCAL_PATH=C:/code/frankencoin-collateral-assessments
PROTOCOL_FIXTURES_DIR=./test/fixtures
