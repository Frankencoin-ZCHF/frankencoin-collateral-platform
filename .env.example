# All variables are optional. The server boots with none of them set;
# a missing value only degrades the feature that needs it.

# Public origin used for canonical/OG URLs.
SITE=https://collateral.frankencoin.com
PORT=3000

# GitHub token (classic or fine-grained, read-only "public_repo"/"discussions:read" is enough).
# Needed for: community discussions (GraphQL requires auth) and for the 5000 req/h
# rate limit when browsing assessment version history. Without it: discussions
# render as a link only, and history falls back to the 60 req/h unauthenticated quota.
GITHUB_TOKEN=

# Where the assessments live. Defaults shown.
ASSESSMENTS_REPO=Frankencoin-ZCHF/frankencoin-collateral-assessments
ASSESSMENTS_REF=main
DISCUSSIONS_REPO=Frankencoin-ZCHF/Frankencoin

# Optional CoinGecko Pro key for 24h change / market-cap enrichment.
COINGECKO_API_KEY=

# Comma-separated host allowlist for URLs declared in assessment content blocks (```block fences).
# Production default (when unset): a built-in list of known public data hosts — see
# DEFAULT_ALLOWED_HOSTS in src/upstream/generic.ts. Development default: any public https host.
# Private/loopback/link-local addresses are always blocked, on every redirect hop, at DNS time.
BLOCK_FETCH_ALLOWED_HOSTS=

# Cache toggle (set to "false" to disable the in-memory cache while debugging).
CACHE_ENABLED=true
