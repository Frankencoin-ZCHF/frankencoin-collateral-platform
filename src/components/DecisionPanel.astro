---
import type { BlockContext } from "@/blocks/types";
import { assessmentExcerpt } from "@/services/assessment-summary";
import { formatCompact, formatDate, formatDateTime, formatPercent } from "@/lib/numbers";
import { itemsFor, monitoringStatus } from "@/services/attention";
import { nearDebtDescription, priceQuality } from "@/services/monitoring";
interface Props {
  ctx: BlockContext;
  protocolFetchedAt: string | null;
  protocolDegraded: string[];
  totalDebt?: number;
}
const { ctx, protocolFetchedAt, protocolDegraded, totalDebt } = Astro.props;
const { record, assessment } = ctx;
const l = record.live;
const findings = itemsFor({ ...record, assessment });
const monitoring = monitoringStatus(record);
const dataFindings = findings.filter((i) => i.queue === "data");
const reviewFindings = findings.filter((i) => i.queue === "review");
const quality = l ? priceQuality(l) : null;
const excerpt = assessment ? assessmentExcerpt(assessment.body) : "";
---

<section class="fc-card p-5 flex flex-col gap-5" aria-label="Collateral overview">
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
    <div>
      <p class="fc-kv-label">Outstanding ZCHF exposure</p><p class="fc-kv-value">{l ? formatCompact(l.totalMintedZchf) : "–"}</p><p
        class="fc-cell-note"
      >
        {
          l && totalDebt
            ? `${formatPercent((l.totalMintedZchf / totalDebt) * 100, 1)} of exposure shown on this platform`
            : l
              ? "Share unavailable"
              : "Protocol exposure unavailable"
        }
      </p>
    </div>
    <div>
      <p class="fc-kv-label">Estimated backing value</p><p class="fc-kv-value">{formatCompact(l?.collateralValueChf)}</p><p
        class="fc-cell-note"
      >
        CHF at reference market prices{quality?.state !== "current" && " · valuation needs verification"}
      </p>
    </div>
    <div>
      <p class="fc-kv-label">{l?.bridge ? "Backing mechanism" : "Nearest price cushion"}</p><p class="fc-kv-value">
        {l?.bridge ? "1 : 1" : formatPercent(l?.safety?.minLiquidationBufferPct, 1)}
      </p><p class="fc-cell-note">
        {
          l?.bridge
            ? `${record.ticker} held in the bridge · issuer exposure`
            : "Distance to a configured liquidation price, at the last observed market price"
        }
      </p>
    </div>
  </div>
  <div class="border-t border-[var(--color-gray-20)] pt-4">
    <p class="ty-small font-bold">{monitoring.label}</p>{
      l?.safety ? (
        <p class="ty-small mt-1">
          {nearDebtDescription(l)}{" "}
          <a href="#position-monitoring" class="underline">
            Inspect positions →
          </a>
        </p>
      ) : (
        <p class="ty-small mt-1">{monitoring.detail}</p>
      )
    }{
      dataFindings.length > 0 && (
        <p class="fc-notice mt-3">
          <strong>Monitoring limitations:</strong> {dataFindings.map((i) => i.title).join(" · ")}.{" "}
          <a href={`/attention#data-${record.slug}`} class="underline">
            Review data quality →
          </a>
        </p>
      )
    }
  </div>
  {
    excerpt && (
      <div class="border-t border-[var(--color-gray-20)] pt-4">
        <>
          <h2 class="ty-title-3 font-bold">The author's assessment</h2>
          <div class="fc-prose fc-summary-prose" set:html={excerpt} />
          <p class="ty-small text-[var(--color-gray-75)]">
            {assessment!.data.author} · assessed {formatDate(assessment!.data.assessmentDate)}
            {assessment!.data.assessmentDate > new Date().toISOString().slice(0, 10) && " (future-dated; verify the author’s date)"} ·{" "}
            {assessment!.status}.{" "}
            <a class="underline" href="#narrative">
              Read the full assessment →
            </a>
          </p>
        </>
      </div>
    )
  }
  <div class="flex flex-wrap gap-x-5 gap-y-2 ty-small text-[var(--color-gray-75)]">
    <a href="#assessment" class="underline"
      >{
        assessment
          ? `${reviewFindings.length} assessment finding${reviewFindings.length === 1 ? "" : "s"}`
          : record.assessmentUnavailable
            ? "Assessment unavailable"
            : "Assessment missing"
      }</a
    ><span>Publication does not establish governance approval.</span>
  </div>
  <div class="border-t border-[var(--color-gray-20)] pt-3 ty-small text-[var(--color-gray-75)]">
    <p>
      Protocol data fetched {formatDateTime(protocolFetchedAt)}. <button
        type="button"
        x-data
        @click="window.location.reload()"
        class="underline">Refresh data</button>
    </p>{
      l && (
        <p class="mt-1">
          Reference price observed {quality?.state === "invalid-time" ? "at an unverified time" : formatDateTime(l.price?.timestamp)} ·{" "}
          {quality?.label.toLowerCase()}.{" "}
          <a href="#changes-sources" class="underline">
            Sources & versions
          </a>
        </p>
      )
    }{
      protocolDegraded.length > 0 && (
        <p class="text-amber-900 mt-1">Some protocol data sources could not be loaded. Displayed totals may be incomplete.</p>
      )
    }
  </div>
</section>
