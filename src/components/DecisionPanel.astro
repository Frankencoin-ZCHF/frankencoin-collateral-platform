---
/* Compact decision panel: the first five questions, answered on one card, with separate clocks
   for the assessment snapshot and the live protocol state. */
import type { BlockContext } from "@/blocks/types";
import LifecycleBadges from "./LifecycleBadges.astro";
import { formatCompact, formatDate, formatDateTime, formatPercent } from "@/lib/numbers";
import { itemsFor } from "@/services/attention";

interface Props {
  ctx: BlockContext;
  protocolFetchedAt: string | null;
  protocolDegraded: string[];
}
const { ctx, protocolFetchedAt, protocolDegraded } = Astro.props as Props;
const { record, assessment, version } = ctx;
const l = record.live;
const s = l?.safety ?? null;
const items = itemsFor(record);
const liveItems = items.filter((i) => i.queue === "live");
const reviewItems = items.filter((i) => i.queue === "review");
const liveHigh = liveItems.filter((i) => i.severity === "high").length;
const bufferTone = s?.minLiquidationBufferPct == null ? "" : s.minLiquidationBufferPct < 5 ? "text-red-700" : s.minLiquidationBufferPct < 15 ? "text-amber-700" : "text-emerald-700";
const today = new Date().toISOString().slice(0, 10);
const futureDate = Boolean(assessment?.data.assessmentDate && assessment.data.assessmentDate > today);
const short = (t: string) => t.replace(/ (differs from draft proposal|deviates from the published assessment)$/, "");
---

<section class="fc-card p-5 flex flex-col gap-4" aria-label="Decision summary">
  <LifecycleBadges record={record} size="lg" />

  {
    assessment?.status === "draft" && (
      <p class="ty-small text-amber-900 bg-amber-50 border border-amber-200 rounded-md px-3 py-2">
        <strong>Draft assessment — under review.</strong> The collateral lifecycle and live protocol settings are shown separately. This assessment is not itself a governance decision or an approved parameter set.
      </p>
    )
  }

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <div>
      <p class="fc-kv-label">Live risk now</p>
      <p class={`fc-kv-value ${liveHigh ? "text-red-700" : liveItems.length ? "text-amber-700" : "text-emerald-700"}`}>
        {liveItems.length > 0 ? <a href={`/attention#${record.slug}`} class="underline decoration-dotted hover:text-[var(--color-brand-swiss)]">{liveItems.length}</a> : "calm"}
      </p>
      <p class="fc-kv-unit">{liveItems.length ? liveItems.map((i) => short(i.title)).join(", ") : "no challenges, no debt near liquidation, sources agree"}</p>
    </div>
    <div>
      <p class="fc-kv-label">Debt (minted ZCHF)</p>
      <p class="fc-kv-value">{l ? formatCompact(l.totalMintedZchf) : "–"}</p>
      <p class="fc-kv-unit">{l?.collateralValueChf != null ? `against ${formatCompact(l.collateralValueChf)} CHF oracle-valued collateral` : "no on-chain positions"}</p>
    </div>
    <div>
      <p class="fc-kv-label">Minimum liquidation buffer</p>
      <p class={`fc-kv-value ${bufferTone}`}>{s ? <a href="#positions-at-risk" class="hover:underline">{formatPercent(s.minLiquidationBufferPct, 1)}</a> : "–"}</p>
      <p class="fc-kv-unit">{s ? <><a href="#positions-at-risk" class="underline decoration-dotted">{formatCompact(s.debtWithin.pct10)} ZCHF within 10 %</a> of liquidation — click for the positions</> : "no priced positions"}</p>
    </div>
    <div>
      <p class="fc-kv-label">Assessment review</p>
      <p class={`fc-kv-value ${reviewItems.length ? "text-[var(--color-neutral-650)]" : ""}`}>
        {reviewItems.length > 0 ? <a href={`/attention#${record.slug}`} class="underline decoration-dotted hover:text-[var(--color-brand-swiss)]">{reviewItems.length}</a> : assessment ? "0" : "–"}
      </p>
      <p class="fc-kv-unit">{reviewItems.length ? reviewItems.map((i) => short(i.title)).join(", ") : assessment ? "live settings match the proposal" : "no assessment to compare"}</p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-3 border-t border-[var(--color-gray-20)] pt-3 ty-xs text-[var(--color-gray-75)]">
    <div>
      <span class="fc-kv-label">Assessment snapshot</span>
      {
        assessment ? (
          <p>
            authored {formatDate(assessment.data.assessmentDate)}{futureDate && <span class="text-amber-700" title="The authored date lies in the future — most likely a typo in the assessment file. It has no bearing on the live figures."> (date in the future — likely a typo)</span>} by <span class="font-bold text-[var(--color-neutral-700)]">{assessment.data.author}</span> · {assessment.status}
            {version && <> · version <span class="font-mono">{version.shortSha}</span> committed {formatDateTime(version.date)}</>}
          </p>
        ) : record.assessmentUnavailable ? (
          <p>temporarily unavailable — the file could not be loaded in this snapshot and will be retried.</p>
        ) : (
          <p>none — this collateral has no risk assessment in the repository.</p>
        )
      }
    </div>
    <div>
      <span class="fc-kv-label">Live protocol state</span>
      <p>
        {l ? <>Ethereum · api.frankencoin.com · fetched {formatDateTime(protocolFetchedAt)} · refreshes every minute{protocolDegraded.length > 0 && <span class="text-amber-700"> · degraded: {protocolDegraded.join(", ")}</span>}</> : "no on-chain data for this contract"}
      </p>
    </div>
    <div>
      <span class="fc-kv-label">Governance reference</span>
      <p>
        {assessment?.data.discussionUrl ? <a href={assessment.data.discussionUrl} target="_blank" rel="noopener noreferrer" class="underline text-[var(--color-blue-39)]">Discussion thread ↗</a> : "not linked"} · approval / review data is not yet published by the protocol
      </p>
    </div>
  </div>
</section>
