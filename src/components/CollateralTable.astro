---
import type { CollateralRow } from "@/lib/rows";
import { matchesFilters, type CollateralView } from "@/lib/collateral-filters";
import { formatCompact, formatDate, formatPercent } from "@/lib/numbers";
interface Props { rows: CollateralRow[]; view?: CollateralView; query?: string; group?: string }
const { rows, view = "current", query = "", group = "all" } = Astro.props;
---
<div data-overview-table class="fc-card overflow-hidden">
  <table class="fc-table fc-collateral-table" role="table" aria-label="Collateral assets and lending terms">
    <thead role="rowgroup"><tr role="row">
      <th scope="col">Asset</th>
      <th scope="col">ZCHF exposure</th>
      <th scope="col">Average overcollateralisation</th>
      <th scope="col">Retained reserve</th>
      <th scope="col">Effective interest / year</th>
      <th scope="col">Global minting limit</th>
    </tr></thead>
    <tbody role="rowgroup">
      {rows.map((r) => (
        <tr role="row" data-collateral-row={r.slug} hidden={!matchesFilters(r, view, query, group)}>
          <td role="cell" data-label="Asset">
            <a href={r.url} class="fc-asset-link">
              <strong>{r.ticker}</strong><span>{r.name}</span>
              <span class="fc-asset-cta">View asset <span aria-hidden="true">→</span></span>
            </a>
            <span class="fc-cell-note">{r.assetType}</span>
            <a class="fc-cell-note underline decoration-dotted" href={`${r.url}#assessment`}>
              {r.assessmentUnavailable ? "Assessment unavailable" : r.status === "none" ? "Not assessed" : `${r.status === "draft" ? "Draft" : r.status === "published" ? "Published" : "Archived"} · ${formatDate(r.assessedOn)}`}
            </a>
            {(r.liveRiskState === "risk" || r.liveRiskState === "watch") && <a class="fc-cell-note underline text-amber-900" href={`${r.url}#position-monitoring`}>{r.monitoringLabel}</a>}
          </td>
          <td role="cell" data-label="ZCHF exposure">
            <strong>{formatCompact(r.mintedZchf)}</strong>
            <span class="fc-cell-note">{formatPercent(r.sharePct, 1)} of total</span>
            {r.outsideReserveZchf === null ? <span class="fc-cell-note">Reserve split unavailable</span> : (
              <span class="fc-cell-note fc-debt-split">
                <span>{formatCompact(r.outsideReserveZchf)} outside reserve*</span>
                <span>{formatCompact(r.reserveRequiredZchf)} minter reserve*</span>
              </span>
            )}
          </td>
          <td role="cell" data-label="Average overcollateralisation">
            <strong>{r.isBridge ? "1:1 bridge" : r.overcollateralisationPct === null ? "—" : `${r.overcollateralisationPct >= 0 ? "+" : ""}${formatPercent(r.overcollateralisationPct, 1)}`}</strong>
            <span class="fc-cell-note">{r.isBridge ? "Issuer-backed stablecoin" : r.mintedZchf === 0 ? "No outstanding debt" : "Collateral value above debt"}</span>
            <span class="fc-cell-note">{r.collateralValueChf === null ? "Backing unavailable" : `${formatCompact(r.collateralValueChf)} CHF backing`}</span>
            {r.collateralValueChf !== null && r.priceQuality !== "current" && <a href={`${r.url}#live-protocol`} class="fc-cell-note underline">Price needs updating</a>}
          </td>
          <td role="cell" data-label="Retained reserve">
            <strong>{r.reserveLabel}</strong>
            {!r.isBridge && <span class="fc-cell-note">of gross minted debt{!r.termsComplete && r.mintedZchf !== 0 ? " · available positions only" : ""}</span>}
          </td>
          <td role="cell" data-label="Effective interest / year">
            <strong>{r.effectiveInterestLabel}</strong>
            {!r.isBridge && <span class="fc-cell-note">After reserve adjustment{!r.termsComplete && r.mintedZchf !== 0 ? " · available positions only" : ""}</span>}
          </td>
          <td role="cell" data-label="Global minting limit">
            <strong>{r.totalLimitZchf === null ? "Unavailable" : `${formatCompact(r.totalLimitZchf)} ZCHF`}</strong>
            <span class="fc-cell-note">{r.limitUsedPct === null ? "" : `${formatPercent(r.limitUsedPct, 1)} used`}</span>
            <span class="fc-cell-note">{r.isBridge ? "Bridge limit" : "Across all originals"}</span>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
