---
import type { CollateralRow } from "@/lib/rows";
import { matchesFilters, type CollateralView } from "@/lib/collateral-filters";
import { formatCompact, formatDate, formatPercent } from "@/lib/numbers";
interface Props {
  rows: CollateralRow[];
  view?: CollateralView;
  query?: string;
  group?: string;
}
const { rows, view = "current", query = "", group = "all" } = Astro.props;
---

<div data-overview-table class="fc-card overflow-hidden">
  <table class="fc-table fc-collateral-table" role="table" aria-label="Collateral assets">
    <thead role="rowgroup"
      ><tr role="row"
        ><th scope="col" role="columnheader">Asset</th><th scope="col" role="columnheader" class="fc-num">ZCHF exposure</th><th
          scope="col"
          role="columnheader"
          class="fc-num">Estimated backing</th
        ><th scope="col" role="columnheader">Price cushion / backing</th><th scope="col" role="columnheader">Current findings</th><th
          scope="col"
          role="columnheader">Assessment</th
        ></tr
      ></thead
    >
    <tbody role="rowgroup">
      {
        rows.map((r) => (
          <tr role="row" data-collateral-row={r.slug} hidden={!matchesFilters(r, view, query, group)}>
            <td role="cell" data-label="Asset">
              <>
                <a
                  href={r.url}
                  class="font-bold text-[var(--color-brand-deep-blue)] underline decoration-transparent hover:decoration-current"
                >
                  {r.name} <span class="font-normal">({r.ticker})</span>
                </a>
                <span class="fc-cell-note">
                  {r.assetType}
                  {r.lifecycle !== "live" && ` · ${r.lifecycle}`}
                </span>
              </>
            </td>
            <td role="cell" data-label="ZCHF exposure" class="fc-num">
              <>
                <strong>{formatCompact(r.mintedZchf)}</strong>
                <span class="fc-cell-note">
                  {r.sharePct === null ? "Share unavailable" : `${formatPercent(r.sharePct, 1)} of total exposure`}
                </span>
              </>
            </td>
            <td role="cell" data-label="Estimated backing" class="fc-num">
              {r.collateralValueChf === null ? "Unavailable" : `${formatCompact(r.collateralValueChf)} CHF`}
              <span class="fc-cell-note">
                {r.priceQuality === "current" ? "At reference market price" : "Valuation needs verification"}
              </span>
            </td>
            <td role="cell" data-label="Price cushion / backing">
              {r.isBridge ? (
                <>
                  <strong>1:1 stablecoin backing</strong>
                  <span class="fc-cell-note">Issuer and redemption exposure</span>
                </>
              ) : (
                <>
                  <strong>{formatPercent(r.minLiquidationBufferPct, 1)}</strong>
                  <span class="fc-cell-note">
                    {r.debtWithin10Pct == null
                      ? "Position monitoring unavailable"
                      : `${formatCompact(r.debtWithin10Pct)} ZCHF (${formatPercent(r.mintedZchf ? (r.debtWithin10Pct / r.mintedZchf) * 100 : null, 1)} of asset debt) within 10%`}
                    {r.priceQuality !== "current" && " · last observed price"}
                  </span>
                </>
              )}
            </td>
            <td role="cell" data-label="Current findings">
              <a
                href={r.attentionUrl}
                class={`fc-finding ${r.liveRiskState === "risk" ? "text-red-800" : r.liveRiskState === "watch" || r.liveRiskState === "unknown" ? "text-amber-900" : "text-[var(--color-neutral-650)]"}`}
              >
                {r.monitoringLabel}
              </a>
              {r.dataQualityCount > 0 && (
                <span class="fc-cell-note">
                  {r.dataQualityCount} data-quality finding{r.dataQualityCount === 1 ? "" : "s"}
                </span>
              )}
            </td>
            <td role="cell" data-label="Assessment">
              <>
                <a href={`${r.url}#assessment`} class="underline decoration-dotted">
                  {r.assessmentUnavailable
                    ? "Unavailable"
                    : r.status === "none"
                      ? "Missing"
                      : r.status === "draft"
                        ? "Draft"
                        : r.status === "published"
                          ? "Published"
                          : "Archived"}
                </a>
                <span class="fc-cell-note">{r.assessedOn ? formatDate(r.assessedOn) : "No assessment date"}</span>
              </>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
