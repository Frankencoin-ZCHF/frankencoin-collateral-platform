---
/* SSR fallback table for the overview (crawlers, no-JS, and the default until the grid loads). */
import type { CollateralRow } from "@/lib/rows";
import { formatCompact, formatPercent, formatPrice } from "@/lib/numbers";
import Pill from "./Pill.astro";

interface Props {
  rows: CollateralRow[];
}
const { rows } = Astro.props as Props;
---

<div data-grid-fallback class="overflow-x-auto rounded-xl border border-[var(--color-gray-20)]">
  <table class="fc-table">
    <thead>
      <tr>
        <th>Ticker</th>
        <th>Lifecycle</th>
        <th>Assessment</th>
        <th>Live risk</th>
        <th class="fc-num">Minted ZCHF</th>
        <th class="fc-num" title="Price drop until the riskiest active position becomes challengeable">Min. liq. buffer</th>
        <th class="fc-num">Open positions</th>
        <th class="fc-num">Oracle price CHF</th>
        <th class="fc-num" title="Assessment-review items">Review</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <td>
              <a href={r.url} class="font-bold text-[var(--color-brand-deep-blue)] hover:text-[var(--color-brand-swiss)]">{r.ticker}</a>
              <span class="block ty-2xs text-[var(--color-gray-60)]">{r.name}</span>
            </td>
            <td><Pill value={r.isBridge ? `${r.lifecycle} · 1:1 bridge` : r.lifecycle} kind={r.lifecycle} /></td>
            <td><Pill value={r.status === "none" ? (r.assessmentUnavailable ? "unavailable" : "none") : r.status} kind={r.status === "none" && r.assessmentUnavailable ? "neutral" : r.status} /></td>
            <td>
              {r.liveRiskState === "ok" ? (
                <span class="fc-pill fc-pill-strong" title="No live risk items at the current oracle price">ok</span>
              ) : (
                <a href={r.attentionUrl} class={`fc-pill ${r.liveRiskState === "risk" ? "fc-pill-insufficient" : "fc-pill-sufficient"}`} title={r.liveRisk.join("\n")}>{r.liveRiskState === "risk" ? "risk" : "watch"} · {r.liveRiskCount}</a>
              )}
            </td>
            <td class="fc-num">{formatCompact(r.mintedZchf)}</td>
            <td class={`fc-num ${r.minLiquidationBufferPct != null && r.minLiquidationBufferPct < 5 ? "text-red-700" : ""}`}>{r.isBridge ? <span class="ty-2xs text-[var(--color-gray-60)]">n/a (1:1)</span> : formatPercent(r.minLiquidationBufferPct, 1)}</td>
            <td class="fc-num">{r.positionsOpen ?? "–"}</td>
            <td class="fc-num">{formatPrice(r.priceChf)}</td>
            <td class="fc-num">{r.reviewCount ? <a href={r.attentionUrl} class="fc-pill fc-pill-neutral" title={r.review.join("\n")}>{r.reviewCount}</a> : "–"}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
