---
/* Grouped "items requiring attention" list: one collapsible row per collateral. */
import Pill from "@/components/Pill.astro";
import type { AttentionGroup } from "@/services/attention";

interface Props {
  groups: AttentionGroup[];
  /** Open every group by default. */
  expanded?: boolean;
}
const { groups, expanded = false } = Astro.props as Props;
const SEV_BAR: Record<string, string> = { high: "bg-red-500", medium: "bg-amber-400", low: "bg-[var(--color-neutral-300)]" };
---

<div x-data="{ open: false, toggleAll() { this.open = !this.open; $el.querySelectorAll('details').forEach(d => d.open = this.open) } }" x-init={expanded ? "open = true" : undefined}>
  {
    groups.length > 0 && (
      <div class="flex justify-end mb-2">
        <button type="button" class="ty-xs font-bold text-[var(--color-blue-39)] hover:text-[var(--color-brand-swiss)]" @click="toggleAll()" x-text="open ? 'Collapse all' : 'Expand all'">Expand all</button>
      </div>
    )
  }
  {
    groups.length === 0 ? (
      <p class="ty-small text-[var(--color-gray-75)]">Nothing requires attention at the current oracle prices.</p>
    ) : (
      <ul class="flex flex-col divide-y divide-[var(--color-gray-20)]">
        {groups.map((g) => (
          <li>
            <details class="group" open={expanded}>
              <summary class="list-none cursor-pointer flex items-center gap-3 py-2.5 -mx-2 px-2 rounded-md hover:bg-[var(--color-gray-10)]">
                <span class={`h-5 w-1 shrink-0 rounded-full ${SEV_BAR[g.severity]}`} aria-label={`${g.severity} severity`} />
                <a href={`/collateral/${g.slug}`} class="ty-small font-bold text-[var(--color-brand-deep-blue)] hover:text-[var(--color-brand-swiss)] w-16 shrink-0" @click.stop>{g.ticker}</a>
                <span class="hidden md:flex items-center gap-1 shrink-0">
                  <Pill value={g.lifecycle} class="!text-[10px] !py-0" />
                  <Pill value={g.assessmentStatus === "none" ? "no assessment" : g.assessmentStatus} kind={g.assessmentStatus} class="!text-[10px] !py-0" />
                </span>
                <span class="ty-xs text-[var(--color-neutral-650)] truncate min-w-0 flex-1">{g.items.map((it) => it.title.replace(/ differs from assessment$/, "")).join(" · ")}</span>
                <span class="ty-2xs text-[var(--color-gray-60)] shrink-0 tabular-nums">{g.items.length}</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 text-[var(--color-gray-60)] transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
              </summary>
              <ul class="pl-4 md:pl-[5.5rem] pb-3 flex flex-col gap-1.5">
                {g.items.map((it) => (
                  <li>
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
                      <span class={`ty-small font-bold ${it.severity === "high" ? "text-red-800" : "text-[var(--color-neutral-700)]"}`}>{it.title}</span>
                      {(it.assessed || it.live) && (
                        <span class="ty-xs tabular-nums whitespace-nowrap text-[var(--color-neutral-650)]">
                          {it.assessed && <><span class="text-[var(--color-gray-60)]">assessed </span>{it.assessed}</>}
                          {it.assessed && it.live && <span class="text-[var(--color-gray-60)]"> → </span>}
                          {it.live && <><span class="text-[var(--color-gray-60)]">live </span>{it.live}</>}
                        </span>
                      )}
                    </div>
                    <p class="ty-xs text-[var(--color-gray-75)] leading-snug">{it.detail}</p>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ))}
      </ul>
    )
  }
</div>
