---
/* Ported from frankencoin-site. */
import StatsBox, { type StatOption } from "./StatsBox.astro";

interface Props {
  options: StatOption[];
  cols?: 2 | 3 | 4 | 6;
}

const { options, cols = 3 } = Astro.props as Props;
const colCls = {
  2: "grid-cols-2",
  3: "grid-cols-2 lg:grid-cols-3",
  4: "grid-cols-2 lg:grid-cols-4",
  6: "grid-cols-2 md:grid-cols-3 lg:grid-cols-6",
}[cols];
---

<div class={`grid w-full ${colCls} gap-4`}>
  {options.map((option) => <StatsBox {...option} />)}
</div>
