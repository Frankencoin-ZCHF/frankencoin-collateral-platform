---
import type { BlockContext } from "@/blocks/types";
import LifecycleBadges from "./LifecycleBadges.astro";
import { assetProfile } from "@/lib/assets";
import { formatDate, shortAddress } from "@/lib/numbers";
interface Props {
  ctx: BlockContext;
}
const { ctx } = Astro.props;
const { record, assessment, version, isHistorical } = ctx;
const profile = assetProfile(record.address, Boolean(record.live?.bridge));
---

<div class="flex flex-col gap-4">
  <nav class="ty-small text-[var(--color-gray-75)]" aria-label="Breadcrumb">
    <a href="/" class="underline">Assets</a>
    <span aria-hidden="true">›</span>
    {record.ticker}
  </nav>
  <div>
    <p class="ty-subtitle">{profile.type} · {record.live?.chainName ?? "Ethereum"}</p><h1 class="ty-large-title">
      {record.name}{" "}
      <span class="ty-title-2">{record.ticker}</span>
    </h1><p class="ty-body-2 mt-3 max-w-3xl text-[var(--color-neutral-650)]">{profile.description}</p>
  </div>
  <LifecycleBadges record={{ ...record, assessment }} />
  {
    record.addressMismatch && (
      <p class="fc-notice" role="alert">
        <strong>Contract identity needs correction.</strong> This assessment references {shortAddress(record.addressMismatch.assessed, 6)}.
        The protocol's similarly named token has a different contract and is shown in a{" "}
        <a class="underline" href={`/collateral/${record.addressMismatch.liveSlug}`}>
          separate asset record
        </a>
        .
      </p>
    )
  }
  {
    isHistorical && version && (
      <p class="fc-notice" role="status">
        <strong>Historical assessment: {formatDate(version.date)}.</strong> Protocol figures remain the latest available snapshot. This is
        not a historical protocol snapshot.{" "}
        <a class="underline" href={`/collateral/${record.slug}`}>
          Return to latest assessment →
        </a>
      </p>
    )
  }
</div>
