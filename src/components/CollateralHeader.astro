---
import type { BlockContext } from "@/blocks/types";
import Pill from "@/components/Pill.astro";
import CopyButton from "@/components/CopyButton.astro";
import Button from "@/components/Button/Button.astro";
import ui from "@/content/ui.json";
import { ETHERSCAN } from "@/lib/constants";
import { formatDate, formatDateTime, shortAddress } from "@/lib/numbers";
import * as assessments from "@/services/assessments";

interface Props {
  ctx: BlockContext;
}
const { ctx } = Astro.props as Props;
const { record, assessment, isHistorical, version, versions } = ctx;
const a = assessment;
const latestSha = versions[0]?.sha ?? null;
---

<div class="flex flex-col gap-5">
  <nav class="ty-xs text-[var(--color-gray-75)]" aria-label="Breadcrumb">
    <a href="/" class="hover:underline">Collaterals</a> <span aria-hidden="true">›</span> <span>{record.ticker}</span>
  </nav>

  <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2 mb-1">
        <h1 class="ty-large-title">{record.name}</h1>
        <span class="ty-title-2 text-[var(--color-brand-titan-gray)]">{record.ticker}</span>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        {a ? <Pill value={a.status} /> : <Pill value={ui.labels.liveOnly} kind="live" />}
        {record.live && record.live.positions.active > 0 && <Pill value={`${record.live.positions.active} active position${record.live.positions.active === 1 ? "" : "s"}`} kind="brand" />}
        {record.live && record.live.positions.active === 0 && <Pill value={ui.labels.notLive} kind="neutral" />}
        {!record.live && <Pill value={ui.labels.notLive} kind="neutral" />}
      </div>

      {
        record.address && (
          <div class="mt-3 flex flex-wrap items-center gap-2 ty-xs text-[var(--color-gray-75)]">
            <span class="font-mono" title={record.address}>{shortAddress(record.address, 8)}</span>
            <CopyButton value={record.address} />
            <a href={`${ETHERSCAN}/token/${record.address}`} target="_blank" rel="noopener noreferrer" class="underline">Etherscan ↗</a>
            <span>· Ethereum</span>
          </div>
        )
      }

      {
        record.addressMismatch && (
          <p class="mt-2 rounded-md bg-amber-50 border border-amber-200 px-3 py-1.5 text-amber-900" style="font-size: var(--font-size-xs)">
            ⚠ The assessment lists contract <span class="font-mono">{record.addressMismatch.assessed ?? "(none)"}</span>; on-chain data shown is for the protocol's listed {record.ticker} token <span class="font-mono">{shortAddress(record.addressMismatch.onchain, 6)}</span> (matched by symbol).
          </p>
        )
      }

      {
        a && a.data.links.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">
            {a.data.links.map((l) => (
              <a href={l.url} target="_blank" rel="noopener noreferrer" class="fc-pill fc-pill-neutral !normal-case !tracking-normal !font-medium hover:bg-[var(--color-neutral-300)]">{l.label} ↗</a>
            ))}
            {a.data.discussionUrl && (
              <a href={a.data.discussionUrl} target="_blank" rel="noopener noreferrer" class="fc-pill fc-pill-neutral !normal-case !tracking-normal !font-medium hover:bg-[var(--color-neutral-300)]">Discussion ↗</a>
            )}
          </div>
        )
      }
    </div>

    {
      a && (
        <div class="fc-card p-4 shrink-0 lg:w-80 flex flex-col gap-3">
          <div class="flex items-baseline justify-between gap-2">
            <p class="fc-card-title">{ui.labels.version}</p>
            <a href={assessments.fileUrl(a.path, version?.sha)} target="_blank" rel="noopener noreferrer" class="ty-2xs text-[var(--color-blue-39)] underline">{ui.buttons.viewOnGitHub} ↗</a>
          </div>
          {versions.length > 0 ? (
            <select
              aria-label="Select assessment version"
              class="w-full rounded-lg border border-[var(--color-gray-30)] bg-white px-3 py-2 ty-small focus:outline-none focus:border-[var(--color-brand-swiss)]"
              onchange="if (this.value) window.location.href = this.value"
            >
              {versions.map((v, i) => (
                <option value={i === 0 ? `/collateral/${record.slug}` : `/collateral/${record.slug}?v=${v.sha}`} selected={version ? v.sha === version.sha : i === 0}>
                  {formatDate(v.date)} · {v.shortSha} · {v.message.slice(0, 40)}{i === 0 ? " (latest)" : ""}
                </option>
              ))}
            </select>
          ) : (
            <p class="ty-small text-[var(--color-gray-75)]">{a.ref ? `${formatDate(a.ref.date)} · ${a.ref.shortSha}` : "History unavailable"}</p>
          )}
          <div class="flex flex-wrap gap-2">
            {version && latestSha && version.sha !== latestSha && (
              <Button href={`/collateral/${record.slug}/compare?from=${version.sha}&to=${latestSha}`} variant="secondary" size="sm" rounded="full">{ui.buttons.compare} with latest</Button>
            )}
            {!isHistorical && versions.length > 1 && (
              <Button href={`/collateral/${record.slug}/compare?from=${versions[1]!.sha}&to=${versions[0]!.sha}`} variant="secondary" size="sm" rounded="full">What changed last</Button>
            )}
            <Button href={`/api/collateral/${record.slug}.json`} variant="ghost" size="sm">JSON</Button>
          </div>
        </div>
      )
    }
  </div>

  {
    isHistorical && version && (
      <div class="rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 ty-small text-amber-900 flex flex-col md:flex-row md:items-center justify-between gap-2" role="status">
        <span>
          <strong>{ui.labels.viewingVersion}</strong> — {formatDateTime(version.date)} · {version.authorLogin ?? version.author} · “{version.message}”. Live protocol data is always current.
        </span>
        <a href={`/collateral/${record.slug}`} class="font-bold underline shrink-0">{ui.labels.backToLatest} →</a>
      </div>
    )
  }
</div>
