---
import Base from "@/layouts/Base.astro";
import Section from "@/components/Layout/Section.astro";
import StatsContainer from "@/components/StatsContainer/StatsContainer.astro";
import CollateralTable from "@/components/CollateralTable.astro";
import Unavailable from "@/components/Unavailable.astro";
import Button from "@/components/Button/Button.astro";
import Pill from "@/components/Pill.astro";
import ui from "@/content/ui.json";
import * as collaterals from "@/services/collaterals";
import { attentionGroups } from "@/services/attention";
import { toRow } from "@/lib/rows";
import { jsonForScript } from "@/lib/html";
import { formatCompact, formatDateTime, formatNumber } from "@/lib/numbers";
import { describeForLog } from "@/lib/errors";

export const prerender = false;

let set: Awaited<ReturnType<typeof collaterals.all>> | null = null;
try {
  set = await collaterals.all();
} catch (e) {
  console.error(`[index] ${describeForLog(e)}`);
}

const records = set?.records ?? [];
const rows = records.map(toRow);
const summary = collaterals.summarize(records);
const attention = attentionGroups(records);
const attentionCount = attention.reduce((n, g) => n + g.items.length, 0);
const VISIBLE_GROUPS = 6;
const SEV_BAR: Record<string, string> = { high: "bg-red-500", medium: "bg-amber-400", low: "bg-[var(--color-neutral-300)]" };

const lifecycleKpis = [
  { label: "Live collaterals", value: String(summary.lifecycle.live), sub: "with open positions", href: "#collaterals" },
  { label: "Proposed", value: String(summary.lifecycle.proposed), sub: "known to the protocol, nothing open" },
  { label: "Draft", value: String(summary.lifecycle.draft), sub: "assessment only, not on-chain" },
  { label: "Closed / denied", value: String(summary.lifecycle.closed + summary.lifecycle.denied), sub: `${summary.lifecycle.closed} closed · ${summary.lifecycle.denied} denied` },
  { label: "Published assessments", value: String(summary.assessments.published), sub: `${summary.assessments.draft} draft · ${summary.assessments.deprecated} deprecated` },
  { label: "Live without published assessment", value: String(summary.liveWithoutPublished), sub: summary.liveWithoutPublished ? "review coverage gap" : "full coverage", href: "#attention" },
];
const exposureKpis = [
  { label: "Minted ZCHF against live collateral", value: formatCompact(summary.totalMintedZchf), sub: `${formatNumber(summary.activePositions, 0)} open positions` },
  { label: "Oracle-valued collateral", value: formatCompact(summary.totalCollateralValueChf), unit: "CHF", sub: "locked in open positions" },
  { label: "Debt within 10 % of liquidation", value: formatCompact(summary.debtWithin10Pct), unit: "ZCHF", sub: summary.debtWithin10Pct > 0 ? "requires attention" : "none at the current oracle price", href: "#attention" },
  { label: "Integrity issues", value: String(summary.integrityIssues), sub: summary.integrityIssues ? "see items requiring attention" : "no open issues", href: "#attention" },
];

// Chart payloads
const withMint = rows.filter((r) => (r.mintedZchf ?? 0) > 0).sort((a, b) => (b.mintedZchf ?? 0) - (a.mintedZchf ?? 0));
const mintedSeries = { labels: withMint.slice(0, 14).map((r) => r.ticker), values: withMint.slice(0, 14).map((r) => r.mintedZchf ?? 0), unit: "ZCHF", name: "Minted ZCHF" };
const valueRows = rows.filter((r) => (r.collateralValueChf ?? 0) > 0).sort((a, b) => (b.collateralValueChf ?? 0) - (a.collateralValueChf ?? 0));
const top = valueRows.slice(0, 8);
const rest = valueRows.slice(8).reduce((n, r) => n + (r.collateralValueChf ?? 0), 0);
const valueSeries = {
  labels: [...top.map((r) => r.ticker), ...(rest > 0 ? ["Other"] : [])],
  values: [...top.map((r) => r.collateralValueChf ?? 0), ...(rest > 0 ? [rest] : [])],
  unit: "CHF",
};

const protocolAt = set?.protocolFetchedAt ? formatDateTime(set.protocolFetchedAt) : null;
const assessmentsAt = set?.assessmentsFetchedAt ? formatDateTime(set.assessmentsFetchedAt) : null;
Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=60");
---

<Base>
  <Section variant="accent" pad="xs" width="wide" id="top">
    <div class="flex flex-col gap-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div class="max-w-3xl">
          <p class="ty-subtitle">FRANKENCOIN · COLLATERAL PLATFORM</p>
          <h1 class="ty-large-title">Collaterals</h1>
          <p class="ty-body-1 text-[var(--color-neutral-650)] mt-2">
            Collateral assessments published by their named authors, with live protocol data, version history and community discussion — and the collateral's lifecycle shown separately from the stage of its assessment.
          </p>
        </div>
        <div class="flex gap-3 shrink-0">
          <Button href="/framework" variant="secondary" size="sm">Risk framework</Button>
          <Button href={ui.nav.links[2]!.href} variant="primary" rounded="full" size="sm" external withExternalIcon>Propose a collateral</Button>
        </div>
      </div>

      {set?.warnings.map((w) => <Unavailable message={w} compact />)}
      {!set && <Unavailable message="Neither the assessments repository nor the protocol API could be reached. Try again in a minute." />}

      <div>
        <p class="fc-card-title mb-2">Collateral lifecycle · assessment stage</p>
        <StatsContainer options={lifecycleKpis} cols={6} />
      </div>
      <div>
        <p class="fc-card-title mb-2">Exposure and risk</p>
        <StatsContainer options={exposureKpis} cols={4} />
      </div>
      <p class="ty-2xs text-[var(--color-gray-60)]">
        Live protocol state fetched {protocolAt ?? "–"} (api.frankencoin.com, refreshes every minute)
        {set?.assessmentsHead && <> · assessment snapshot at commit <a class="underline font-mono" href={`https://github.com/${set.assessmentsHead.url.split("/").slice(3, 5).join("/")}/commit/${set.assessmentsHead.sha}`} target="_blank" rel="noopener noreferrer">{set.assessmentsHead.shortSha}</a> ({formatDateTime(set.assessmentsHead.date)}), read {assessmentsAt}</>}
      </p>
    </div>
  </Section>

  {
    rows.length > 0 && (
      <Section pad="xxs" width="wide" id="dashboard">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
          <div class="fc-card p-5 lg:col-span-2 self-start" id="attention" x-data="{ all: false }">
            <div class="flex items-baseline justify-between gap-3 mb-1">
              <p class="fc-card-title">Items requiring attention</p>
              <span class="ty-2xs text-[var(--color-gray-60)]">{attentionCount} item{attentionCount === 1 ? "" : "s"} across {attention.length} collateral{attention.length === 1 ? "" : "s"}</span>
            </div>
            <p class="ty-2xs text-[var(--color-gray-60)] mb-4">Integrity issues, live parameters that deviate from the assessment in the less conservative direction, debt close to liquidation, and running challenges.</p>
            {attention.length === 0 ? (
              <p class="ty-small text-[var(--color-gray-75)]">Nothing requires attention at the current oracle prices.</p>
            ) : (
              <ul class="flex flex-col divide-y divide-[var(--color-gray-20)]">
                {attention.map((g, gi) => (
                  <li class={`py-3 first:pt-0 last:pb-0 flex gap-3 ${gi >= VISIBLE_GROUPS ? "attention-more" : ""}`} x-show={gi >= VISIBLE_GROUPS ? "all" : undefined} x-cloak={gi >= VISIBLE_GROUPS ? true : undefined}>
                    <span class={`mt-1 w-1 shrink-0 rounded-full ${SEV_BAR[g.severity]}`} aria-label={`${g.severity} severity`} />
                    <div class="min-w-0 flex-1">
                      <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                        <a href={`/collateral/${g.slug}`} class="ty-body-2 font-bold text-[var(--color-brand-deep-blue)] hover:text-[var(--color-brand-swiss)]">{g.ticker}</a>
                        <span class="ty-xs text-[var(--color-gray-60)] truncate max-w-56">{g.name}</span>
                        <Pill value={g.lifecycle} class="!text-[10px] !py-0" />
                        <Pill value={g.assessmentStatus === "none" ? "no assessment" : `${g.assessmentStatus} assessment`} kind={g.assessmentStatus} class="!text-[10px] !py-0" />
                      </div>
                      <ul class="mt-1.5 flex flex-col gap-1.5">
                        {g.items.map((it) => (
                          <li>
                            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
                              <span class={`ty-small font-bold ${it.severity === "high" ? "text-red-800" : "text-[var(--color-neutral-700)]"}`}>{it.title}</span>
                              {(it.assessed || it.live) && (
                                <span class="ty-xs tabular-nums whitespace-nowrap text-[var(--color-neutral-650)]">
                                  {it.assessed && <><span class="text-[var(--color-gray-60)]">assessed </span>{it.assessed}</>}
                                  {it.assessed && it.live && <span class="text-[var(--color-gray-60)]"> → </span>}
                                  {it.live && <><span class="text-[var(--color-gray-60)]">live </span>{it.live}</>}
                                </span>
                              )}
                            </div>
                            <p class="ty-xs text-[var(--color-gray-75)] leading-snug">{it.detail}</p>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </li>
                ))}
              </ul>
            )}
            {attention.length > VISIBLE_GROUPS && (
              <button type="button" class="mt-4 ty-small font-bold text-[var(--color-blue-39)] hover:text-[var(--color-brand-swiss)]" @click="all = !all" x-text={`all ? 'Show fewer' : 'Show all ${attention.length} collaterals'`}>Show all {attention.length} collaterals</button>
            )}
          </div>
          <div class="flex flex-col gap-4">
            <div class="fc-card p-4">
              <p class="fc-card-title mb-2">Minted ZCHF per collateral</p>
              <div data-chart="bar" data-series={JSON.stringify(mintedSeries)} class="h-52" />
            </div>
            <div class="fc-card p-4">
              <p class="fc-card-title mb-2">Oracle-valued collateral share</p>
              <div data-chart="donut" data-series={JSON.stringify(valueSeries)} class="h-52" />
            </div>
          </div>
        </div>
      </Section>
    )
  }

  <Section pad="xs" width="wide" id="collaterals">
    <div class="flex flex-col gap-4">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
        <div>
          <h2 class="ty-title-1">All collaterals</h2>
          <p class="ty-small text-[var(--color-gray-75)]"><span id="grid-count">{rows.length}</span> shown · one row per contract address</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <input id="grid-search" type="search" placeholder="Search…" aria-label="Search collaterals" class="h-9 rounded-full border border-[var(--color-gray-30)] px-4 ty-small w-48 focus:outline-none focus:border-[var(--color-brand-swiss)]" />
          <details class="relative">
            <summary class="list-none h-9 inline-flex items-center px-4 rounded-full border border-[var(--color-gray-30)] ty-small cursor-pointer hover:bg-[var(--color-gray-10)]">Columns</summary>
            <div id="grid-columns-menu" class="absolute right-0 z-30 mt-1 max-h-80 overflow-y-auto rounded-lg border border-[var(--color-gray-20)] bg-white shadow-lg py-1 min-w-52"></div>
          </details>
          <button id="grid-export" type="button" class="h-9 inline-flex items-center px-4 rounded-full border border-[var(--color-gray-30)] ty-small hover:bg-[var(--color-gray-10)]">{ui.buttons.exportCsv}</button>
          <button id="grid-reset" type="button" class="h-9 inline-flex items-center px-4 rounded-full ty-small text-[var(--color-gray-75)] hover:text-[var(--color-brand-deep-blue)]">{ui.buttons.resetFilters}</button>
        </div>
      </div>

      <div class="flex flex-col gap-2" role="group" aria-label="Filters">
        <div class="flex flex-wrap gap-2 items-center">
          <span class="ty-xs uppercase tracking-wider text-[var(--color-gray-75)] w-24">Lifecycle</span>
          {[["lifecycle:all", "All"], ["lifecycle:live", "Live"], ["lifecycle:proposed", "Proposed"], ["lifecycle:draft", "Draft"], ["lifecycle:closed", "Closed"], ["lifecycle:denied", "Denied"]].map(([chip, label]) => (
            <button type="button" data-chip={chip} aria-pressed={chip === "lifecycle:all"} class="chip">{label}</button>
          ))}
        </div>
        <div class="flex flex-wrap gap-2 items-center">
          <span class="ty-xs uppercase tracking-wider text-[var(--color-gray-75)] w-24">Assessment</span>
          {[["status:all", "All"], ["status:published", "Published"], ["status:draft", "Draft"], ["status:deprecated", "Deprecated"], ["status:none", "None"]].map(([chip, label]) => (
            <button type="button" data-chip={chip} aria-pressed={chip === "status:all"} class="chip">{label}</button>
          ))}
          <span class="ty-xs uppercase tracking-wider text-[var(--color-gray-75)] ml-3 mr-1">Free float</span>
          {[["class:all", "Any"], ["class:strong", "Strong"], ["class:sufficient", "Sufficient"], ["class:insufficient", "Insufficient"]].map(([chip, label]) => (
            <button type="button" data-chip={chip} aria-pressed={chip === "class:all"} class="chip">{label}</button>
          ))}
          <button type="button" data-chip="issues:toggle" aria-pressed="false" class="chip ml-3">With issues only</button>
        </div>
      </div>

      <script is:inline type="application/json" id="grid-data" set:html={jsonForScript(rows)} />
      <div id="collateral-grid" hidden class="w-full"></div>
      <CollateralTable rows={rows} />
      <noscript><p class="ty-xs text-[var(--color-gray-75)]">Enable JavaScript for sorting, filtering and CSV export.</p></noscript>
    </div>
  </Section>
</Base>

<script>
  import "@/scripts/charts-loader";
  import "@/scripts/grid-loader";
</script>
