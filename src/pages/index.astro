---
import Base from "@/layouts/Base.astro";
import Section from "@/components/Layout/Section.astro";
import StatsContainer from "@/components/StatsContainer/StatsContainer.astro";
import CollateralTable from "@/components/CollateralTable.astro";
import Unavailable from "@/components/Unavailable.astro";
import Button from "@/components/Button/Button.astro";
import ui from "@/content/ui.json";
import * as collaterals from "@/services/collaterals";
import { summarizeAttention } from "@/services/attention";
import { toRow } from "@/lib/rows";
import { jsonForScript } from "@/lib/html";
import { formatCompact, formatDateTime, formatNumber, formatPercent } from "@/lib/numbers";
import { describeForLog } from "@/lib/errors";

export const prerender = false;

let set: Awaited<ReturnType<typeof collaterals.all>> | null = null;
try {
  set = await collaterals.all();
} catch (e) {
  console.error(`[index] ${describeForLog(e)}`);
}

const records = set?.records ?? [];
const rows = records.map(toRow);
const summary = collaterals.summarize(records);
const att = summarizeAttention(records);
const calm = att.live.items === 0;

// 1. Protocol risk now
const riskKpis = [
  {
    label: "Live risk now",
    value: String(att.live.items),
    sub: calm ? "nothing at the current oracle price" : `${att.live.high ? att.live.high + " high · " : ""}${att.live.collaterals} collateral${att.live.collaterals === 1 ? "" : "s"} · view live-risk queue →`,
    href: "/attention#live",
    tooltip: "Active challenges, debt close to liquidation, stale or divergent data, integrity exceptions",
  },
  { label: "Active challenges", value: String(att.live.challenges), sub: att.live.challenges ? "liquidation auctions running" : "no auctions running", href: att.live.challenges ? "/attention#live" : "https://app.frankencoin.com/challenges" },
  {
    label: "Debt within 10 % of liquidation",
    value: formatCompact(att.live.debtWithin10Pct),
    unit: "ZCHF",
    sub: att.live.debtWithin10Pct > 0 ? "a 10 % price drop would make it challengeable" : "none at the current oracle price",
    href: "/attention#live",
    tooltip: "ZCHF minted in positions whose liquidation price is within 10 % of the current oracle price",
  },
  { label: "Data-integrity exceptions", value: String(att.live.integrity), sub: att.live.integrity ? "source divergence, address mismatch, missing assessment" : "sources agree", href: "/attention#live" },
];

// 2. Exposure
const exposureKpis = [
  { label: "Minted ZCHF", value: formatCompact(summary.totalMintedZchf), sub: `${formatNumber(summary.activePositions, 0)} open positions · ${formatCompact(summary.bridgeMintedZchf)} of it via ${summary.liveBridges} live 1:1 bridge${summary.liveBridges === 1 ? "" : "s"} (no collateral buffer)` },
  { label: "Oracle-valued collateral", value: formatCompact(summary.totalCollateralValueChf), unit: "CHF", sub: "collateral quantity × current oracle price", tooltip: "Collateral quantity × current protocol oracle price, summed over open positions" },
  { label: "Remaining aggregate limit", value: formatCompact(summary.totalRemainingLimitZchf), unit: "ZCHF", sub: "additional ZCHF mintable under current limits", tooltip: "Sum over collaterals of total limit − minted" },
  summary.concentration
    ? { label: "Largest concentration", value: formatPercent(summary.concentration.sharePct, 0), sub: `${summary.concentration.ticker} of all minted ZCHF`, href: `/collateral/${summary.concentration.slug}` }
    : { label: "Largest concentration", value: "–", sub: "no live collateral" },
];

// 3. Coverage and governance
const cov = summary.coverage;
const coverageKpis = [
  {
    label: "Assessment coverage (live collaterals)",
    value: `${cov.published} · ${cov.draft} · ${cov.missing}`,
    sub: `published · under review · missing${cov.unavailable ? ` (+${cov.unavailable} temporarily unavailable)` : ""}`,
    href: cov.missing ? "/attention#live" : "#collaterals",
    tooltip: "Published = formally published assessment; under review = draft exists; missing = no assessment record at all",
  },
  { label: "Assessment review queue", value: String(att.review.items), sub: att.review.items ? `${att.review.parameterDifferences} draft-proposal difference${att.review.parameterDifferences === 1 ? "" : "s"} · ${att.review.collaterals} collateral${att.review.collaterals === 1 ? "" : "s"} · view →` : "nothing to review", href: "/attention#review" },
  { label: "Lifecycle", value: `${summary.lifecycle.live} live`, sub: `${summary.lifecycle.proposed} proposed · ${summary.lifecycle.draft} draft · ${summary.lifecycle.closed} closed · ${summary.lifecycle.denied} denied`, href: "#collaterals" },
  { label: "Assessments in repository", value: String(summary.assessments.published + summary.assessments.draft + summary.assessments.deprecated), sub: `${summary.assessments.published} published · ${summary.assessments.draft} draft · ${summary.assessments.deprecated} deprecated`, href: "https://github.com/Frankencoin-ZCHF/frankencoin-collateral-assessments" },
];

// Chart payloads
const withMint = rows.filter((r) => (r.mintedZchf ?? 0) > 0).sort((a, b) => (b.mintedZchf ?? 0) - (a.mintedZchf ?? 0));
const mintedTop = withMint.slice(0, 14);
const mintedSeries = { labels: mintedTop.map((r) => r.ticker), values: mintedTop.map((r) => r.mintedZchf ?? 0), links: mintedTop.map((r) => r.url), unit: "ZCHF", name: "Minted ZCHF" };
const valueRows = rows.filter((r) => (r.collateralValueChf ?? 0) > 0).sort((a, b) => (b.collateralValueChf ?? 0) - (a.collateralValueChf ?? 0));
const top = valueRows.slice(0, 8);
const rest = valueRows.slice(8).reduce((n, r) => n + (r.collateralValueChf ?? 0), 0);
const valueSeries = {
  labels: [...top.map((r) => r.ticker), ...(rest > 0 ? ["Other"] : [])],
  values: [...top.map((r) => r.collateralValueChf ?? 0), ...(rest > 0 ? [rest] : [])],
  links: [...top.map((r) => r.url), ...(rest > 0 ? [null] : [])],
  unit: "CHF",
};

const protocolAt = set?.protocolFetchedAt ? formatDateTime(set.protocolFetchedAt) : null;
const assessmentsAt = set?.assessmentsFetchedAt ? formatDateTime(set.assessmentsFetchedAt) : null;
const chipGroups: { key: string; label: string; aria: string; chips: [string, string][] }[] = [
  { key: "lifecycle", label: "Lifecycle", aria: "Lifecycle", chips: [["all", "All"], ["live", "Live"], ["proposed", "Proposed"], ["draft", "Draft"], ["closed", "Closed"], ["denied", "Denied"]] },
  { key: "status", label: "Assessment", aria: "Assessment stage", chips: [["all", "All"], ["published", "Published"], ["draft", "Draft"], ["deprecated", "Deprecated"], ["none", "None"]] },
  { key: "class", label: "Free float", aria: "Free-float class", chips: [["all", "Any"], ["strong", "Strong"], ["sufficient", "Sufficient"], ["insufficient", "Insufficient"]] },
];
Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=60");
---

<Base>
  <Section variant="accent" pad="xs" width="wide" id="top">
    <div class="flex flex-col gap-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div class="max-w-3xl">
          <p class="ty-subtitle">FRANKENCOIN · COLLATERAL PLATFORM</p>
          <h1 class="ty-large-title">Collaterals</h1>
          <p class="ty-body-1 text-[var(--color-neutral-650)] mt-2">
            Live risk first, then exposure, then assessment coverage. Collateral assessments are published by their named authors; the collateral's lifecycle is shown separately from the stage of its assessment.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 shrink-0">
          <Button href="/attention#live" variant="primary" rounded="full" size="sm">{calm ? "Monitor collaterals" : `View live risks (${att.live.items})`}</Button>
          <Button href="/framework" variant="secondary" size="sm">Risk framework</Button>
          <Button href={ui.nav.links.find((l) => l.label === "Discussions")!.href} variant="secondary" size="sm" external withExternalIcon>Propose a collateral</Button>
        </div>
      </div>

      {set?.warnings.map((w) => <Unavailable message={w} compact />)}
      {!set && <Unavailable message="Neither the assessments repository nor the protocol API could be reached. Try again in a minute." />}

      <div>
        <div class="flex items-baseline gap-2 mb-2">
          <p class="fc-card-title">1 · Protocol risk now</p>
          <span class={`fc-pill ${calm ? "fc-pill-strong" : att.live.high ? "fc-pill-insufficient" : "fc-pill-sufficient"}`}>{calm ? "calm" : att.live.high ? "action needed" : "watch"}</span>
        </div>
        <StatsContainer options={riskKpis} cols={4} />
      </div>
      <div>
        <p class="fc-card-title mb-2">2 · Exposure</p>
        <StatsContainer options={exposureKpis} cols={4} />
      </div>
      <div>
        <p class="fc-card-title mb-2">3 · Assessment coverage and governance</p>
        <StatsContainer options={coverageKpis} cols={4} />
      </div>
      <p class="ty-2xs text-[var(--color-gray-60)]">
        Live protocol state fetched {protocolAt ?? "–"} (api.frankencoin.com, refreshes every minute)
        {set?.assessmentsHead && <> · assessment snapshot at commit <a class="underline font-mono" href={`https://github.com/${set.assessmentsHead.url.split("/").slice(3, 5).join("/")}/commit/${set.assessmentsHead.sha}`} target="_blank" rel="noopener noreferrer">{set.assessmentsHead.shortSha}</a> ({formatDateTime(set.assessmentsHead.date)}), read {assessmentsAt}</>}
      </p>
    </div>
  </Section>

  {
    rows.length > 0 && (
      <Section pad="xxs" width="wide" id="dashboard">
        <p class="fc-card-title mb-2">4 · Explore</p>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <div class="fc-card p-4">
            <p class="fc-card-title mb-2">Minted ZCHF per collateral <span class="normal-case tracking-normal text-[var(--color-gray-60)]">· click a bar to open the collateral</span></p>
            <div data-chart="bar" data-series={JSON.stringify(mintedSeries)} class="h-64" />
          </div>
          <div class="fc-card p-4">
            <p class="fc-card-title mb-2">Oracle-valued collateral share <span class="normal-case tracking-normal text-[var(--color-gray-60)]">· collateral quantity × oracle price</span></p>
            <div data-chart="donut" data-series={JSON.stringify(valueSeries)} class="h-64" />
          </div>
        </div>
      </Section>
    )
  }

  <Section pad="xs" width="wide" id="collaterals">
    <div class="flex flex-col gap-4">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
        <div>
          <h2 class="ty-title-1">All collaterals</h2>
          <p class="ty-small text-[var(--color-gray-75)]"><span id="grid-count">{rows.length}</span> shown · one row per contract address · specialist columns are behind “Columns”</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <input id="grid-search" type="search" placeholder="Search…" aria-label="Search collaterals" class="h-9 rounded-full border border-[var(--color-gray-30)] px-4 ty-small w-48 focus:outline-none focus:border-[var(--color-brand-swiss)]" />
          <details class="relative">
            <summary class="list-none h-9 inline-flex items-center px-4 rounded-full border border-[var(--color-gray-30)] ty-small cursor-pointer hover:bg-[var(--color-gray-10)]">Columns</summary>
            <div id="grid-columns-menu" class="absolute right-0 z-30 mt-1 max-h-80 overflow-y-auto rounded-lg border border-[var(--color-gray-20)] bg-white shadow-lg py-1 min-w-52"></div>
          </details>
          <button id="grid-export" type="button" class="h-9 inline-flex items-center px-4 rounded-full border border-[var(--color-gray-30)] ty-small hover:bg-[var(--color-gray-10)]">{ui.buttons.exportCsv}</button>
          <button id="grid-reset" type="button" class="h-9 inline-flex items-center px-4 rounded-full ty-small text-[var(--color-gray-75)] hover:text-[var(--color-brand-deep-blue)]">{ui.buttons.resetFilters}</button>
        </div>
      </div>

      <div class="flex flex-col gap-2" aria-label="Filters">
        {
          chipGroups.map((g) => (
            <div class="flex flex-wrap gap-2 items-center" role="group" aria-label={g.aria}>
              <span class="ty-xs uppercase tracking-wider text-[var(--color-gray-75)] w-24" aria-hidden="true">{g.label}</span>
              {g.chips.map(([value, label]) => (
                <button type="button" data-chip={`${g.key}:${value}`} aria-pressed={value === "all"} aria-label={`${g.aria}: ${label}`} class="chip">{label}</button>
              ))}
              {g.key === "class" && (
                <button type="button" data-chip="issues:toggle" aria-pressed="false" aria-label="Show only collaterals with live risk items" class="chip ml-3">Live risk only</button>
              )}
            </div>
          ))
        }
      </div>

      <script is:inline type="application/json" id="grid-data" set:html={jsonForScript(rows)} />
      <div id="collateral-grid" hidden class="w-full"></div>
      <CollateralTable rows={rows} />
      <noscript><p class="ty-xs text-[var(--color-gray-75)]">Enable JavaScript for sorting, filtering and CSV export.</p></noscript>
    </div>
  </Section>
</Base>

<script>
  import "@/scripts/charts-loader";
  import "@/scripts/grid-loader";
</script>
