---
import Base from "@/layouts/Base.astro";
import Section from "@/components/Layout/Section.astro";
import AttentionList from "@/components/AttentionList.astro";
import * as collaterals from "@/services/collaterals";
import { attentionGroups, summarizeAttention, type Queue } from "@/services/attention";
import { monitoringCoverage } from "@/services/monitoring";
import { describeForLog } from "@/lib/errors";
import { formatCompact, formatDateTime, formatPercent } from "@/lib/numbers";
import { config } from "@/config";
export const prerender = false;
let set: Awaited<ReturnType<typeof collaterals.all>> | null = null;
try {
  set = await collaterals.all();
} catch (e) {
  console.error(`[attention] ${describeForLog(e)}`);
}
const records = set?.records ?? [];
const att = summarizeAttention(records, set?.unattributedActiveChallenges ?? 0);
const coverage = monitoringCoverage(records);
const queues: { id: Queue; title: string; description: string; count: number }[] = [
  {
    id: "live",
    title: "Financial monitoring",
    description:
      "Active challenges, observed price proximity and stablecoin peg changes. Findings using outdated prices describe the last observation; check the data-quality section before interpreting them.",
    count: att.live.items,
  },
  {
    id: "data",
    title: "Data quality",
    description:
      "Outdated or unverified prices, incomplete position data and unavailable sources. These limit what monitoring can tell you; they do not establish a financial loss.",
    count: att.data.items,
  },
  {
    id: "review",
    title: "Assessment findings",
    description:
      "Missing assessments, differences from proposed parameters and governance references to review. A published assessment alone does not establish an adopted governance baseline.",
    count: att.review.items,
  },
];
Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=60");
---

<Base title="Monitoring & review">
  <Section variant="accent" pad="xs" width="wide"
    ><a href="/" class="ty-small underline">All assets</a><h1 class="ty-large-title mt-3">Monitoring & review</h1><p
      class="ty-body-2 mt-3 max-w-3xl"
    >
      Understand the financial observations, the reliability of their data, and the assessments that need further review.
    </p>{
      config.protocolFixturesDir && (
        <p class="fc-notice mt-4">Sample protocol snapshot. These figures are not the current protocol state.</p>
      )
    }{!set?.protocolFetchedAt && <p class="fc-notice mt-4">Protocol data could not be loaded. Financial monitoring is unavailable.</p>}<div
      class="fc-monitoring-strip mt-4"
    >
      <p>
        <strong>{formatPercent(coverage.sharePct, 1)} monitoring coverage</strong> by reported outstanding ZCHF. {
          coverage.monitoredDebt > 0
            ? `${formatCompact(coverage.freshNearDebt)} ZCHF lies within 10% of a liquidation price in the covered data.`
            : "No exposure has complete price-based monitoring in this snapshot."
        }
      </p><p>
        Protocol data fetched {formatDateTime(set?.protocolFetchedAt)}. <button
          x-data
          type="button"
          @click="window.location.reload()"
          class="underline">Refresh data</button>
      </p>
    </div></Section
  >
  <Section pad="xs" width="wide"
    ><nav class="fc-view-tabs mb-6" aria-label="Finding categories">{queues.map((q) => <a href={`#${q.id}`}>{q.title}</a>)}</nav><div
      class="flex flex-col gap-6"
    >
      {
        queues.map((q) => (
          <section id={q.id} class="fc-card p-5 scroll-mt-24" aria-labelledby={`${q.id}-title`}>
            <div class="flex flex-wrap gap-3 items-baseline justify-between">
              <h2 id={`${q.id}-title`} class="ty-title-2 font-bold">{q.title}</h2>
              <span class="ty-small text-[var(--color-gray-75)]">{q.count} findings</span>
            </div>
            <p class="ty-small text-[var(--color-gray-75)] mt-2 mb-4">{q.description}</p>
            {q.id === "live" && (set?.unattributedActiveChallenges ?? 0) > 0 && (
              <p class="fc-notice mb-4">
                {set!.unattributedActiveChallenges} active challenges cannot be assigned to an asset because their positions are missing
                from the feed. They are included in the total.{" "}
                <a class="underline" href="https://app.frankencoin.com/challenges">
                  Inspect challenges ↗
                </a>
              </p>
            )}
            <AttentionList groups={attentionGroups(records, q.id)} queue={q.id} expanded={q.id === "live"} />
          </section>
        ))
      }
    </div></Section
  >
</Base>
<script>
  import "@/scripts/detail-navigation";
</script>
