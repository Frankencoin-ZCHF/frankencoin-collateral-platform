---
import Base from "@/layouts/Base.astro";
import Section from "@/components/Layout/Section.astro";
import AttentionList from "@/components/AttentionList.astro";
import * as collaterals from "@/services/collaterals";
import { attentionGroups } from "@/services/attention";
import { exposureGroups, monitoringCoverage, hasCurrentExposure } from "@/services/monitoring";
import { assessmentPriorities, commonExposures, maturityProfile } from "@/services/insights";
import { describeForLog } from "@/lib/errors";
import { formatCompact, formatDate, formatDateTime, formatPercent, shortAddress } from "@/lib/numbers";
import { config } from "@/config";
export const prerender = false;
let set: Awaited<ReturnType<typeof collaterals.all>> | null = null;
try { set = await collaterals.all(); } catch (e) { console.error(`[attention] ${describeForLog(e)}`); }
const records = set?.records ?? [];
const coverage = monitoringCoverage(records), groups = exposureGroups(records);
const shared = commonExposures(records), maturity = maturityProfile(records), review = assessmentPriorities(records);
const exposed = records.filter(hasCurrentExposure).sort((a, b) => b.live!.totalMintedZchf - a.live!.totalMintedZchf);
const largest = exposed[0];
const missingDebt = exposed.filter(r => !r.assessment || r.assessmentUnavailable).reduce((s, r) => s + r.live!.totalMintedZchf, 0);
Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=60");
---
<Base title="Portfolio insights">
  <Section pad="xs" width="wide">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div><h1 class="ty-title-1">Portfolio insights</h1><p class="ty-body-2 mt-2">Where exposure is concentrated, when debt expires, and which assessments to review first.</p></div>
      <a href="https://app.frankencoin.com/monitoring" target="_blank" rel="noopener noreferrer" class="chip">Monitor positions in the app ↗</a>
    </div>
    {config.protocolFixturesDir && <p class="fc-notice mt-4">Sample protocol snapshot. These figures are not the current protocol state.</p>}
    {!set?.protocolFetchedAt && <p class="fc-notice mt-4">Protocol data is unavailable. Portfolio totals cannot be evaluated.</p>}
    <nav class="fc-view-tabs mt-5" aria-label="Portfolio sections"><a href="#concentration">Concentration</a><a href="#maturity">Debt expiries</a><a href="#review">Assessment review</a></nav>
  </Section>
  <Section pad="xxs" width="wide">
    <div class="flex flex-col gap-6">
      <section id="concentration" class="fc-card p-5 scroll-mt-24" aria-labelledby="concentration-title">
        <h2 id="concentration-title" class="ty-title-2 font-bold">Concentration across assets</h2>
        <div class="fc-kv !grid-cols-1 md:!grid-cols-3 my-5">
          <div><p class="fc-kv-label">Largest asset</p><p class="fc-kv-value">{largest?.ticker ?? "—"} <span class="ty-title-3">{formatPercent(largest && coverage.totalDebt ? largest.live!.totalMintedZchf / coverage.totalDebt * 100 : null, 1)}</span></p>{largest && <a class="ty-small underline" href={`/collateral/${largest.slug}`}>{formatCompact(largest.live!.totalMintedZchf)} ZCHF · view assessment →</a>}</div>
          <div><p class="fc-kv-label">Largest category</p><p class="fc-kv-value">{formatPercent(groups[0]?.sharePct ?? null, 1)}</p><p class="fc-kv-unit">{groups[0]?.label ?? "Unavailable"}</p></div>
          <div><p class="fc-kv-label">Debt without an available assessment</p><p class="fc-kv-value">{set?.protocolFetchedAt ? formatCompact(missingDebt) : "—"} <span class="ty-small">ZCHF</span></p><a class="ty-small underline" href="#review">Review coverage →</a></div>
        </div>
        {shared.length > 0 && <div class="border-t border-[var(--color-gray-20)] pt-4">
          <h3 class="ty-title-3 font-bold">Shared price exposure</h3>
          <p class="ty-small text-[var(--color-gray-75)] mt-1 mb-3">Different tokens can depend on the same underlying market. Their custody and redemption risks remain distinct.</p>
          <ul class="fc-common-exposures">{shared.map(g => <li>
            <div><strong>{g.label}</strong><p class="fc-cell-note">{g.assets.map((a, i) => <>{i > 0 && " · "}<a class="underline" href={`/collateral/${a.slug}`}>{a.ticker}</a></>)}</p></div>
            <div class="fc-num"><strong>{formatCompact(g.debt)} ZCHF</strong><span class="fc-cell-note">{formatPercent(coverage.totalDebt ? g.debt / coverage.totalDebt * 100 : null, 1)} of total exposure</span></div>
          </li>)}</ul>
        </div>}
        <a href="/#collaterals" class="ty-small underline mt-4 inline-block">Compare all asset categories →</a>
      </section>
      <section id="maturity" class="fc-card p-5 scroll-mt-24" aria-labelledby="maturity-title">
        <h2 id="maturity-title" class="ty-title-2 font-bold">When does position debt expire?</h2>
        <p class="ty-small text-[var(--color-gray-75)] mt-2 mb-4">Outstanding position debt, grouped by repayment deadline. Expand a period to find the positions to review.</p>
        {maturity.reportedDebt === 0 ? <p class="ty-small">No outstanding collateralised debt is available in this snapshot.</p> : <div class="fc-maturity-list">
          {maturity.buckets.map(b => <details class="fc-maturity-bucket" open={b.id === "expired" && b.positions.length > 0}>
            <summary><strong>{b.label}</strong><span>{b.positions.length} position{b.positions.length === 1 ? "" : "s"}</span><strong>{formatCompact(b.debt)} ZCHF</strong></summary>
            {b.positions.length === 0 ? <p class="ty-small p-3">No reported positions in this period.</p> : <ul class="fc-maturity-positions">{b.positions.map(p => <li>
              <div><a class="font-bold underline" href={`/collateral/${p.slug}#position-monitoring`}>{p.ticker}</a><span class="fc-cell-note">{formatDate(p.position.expiresAt)}</span></div>
              <span>{formatCompact(p.position.minted)} ZCHF</span>
              <a class="underline" href={p.position.url} target="_blank" rel="noopener noreferrer" aria-label={`Inspect ${p.ticker} position ${shortAddress(p.position.address)}`}>{shortAddress(p.position.address)} ↗</a>
            </li>)}</ul>}
          </details>)}
        </div>}
        <p class="ty-small text-[var(--color-gray-75)] mt-3">{formatCompact(maturity.coveredDebt)} ZCHF in the position feed / {formatCompact(maturity.reportedDebt)} reported collateralised debt.{maturity.incompleteAssets > 0 && ` ${maturity.incompleteAssets} asset feeds are incomplete.`} Bridge minting horizons are excluded: they do not end redemption.</p>
      </section>
      <section id="review" class="fc-card p-5 scroll-mt-24" aria-labelledby="review-title">
        <h2 id="review-title" class="ty-title-2 font-bold">Assessment review, ordered by exposure</h2>
        <p class="ty-small text-[var(--color-gray-75)] mt-2 mb-4">Start with the assets representing the most outstanding ZCHF. Differences are against the author’s assessment or proposal, not a governance verdict.</p>
        {review.length === 0 ? <p class="ty-small">No review priorities could be identified from the available assessments and protocol data.</p> : <div class="overflow-x-auto"><table class="fc-table fc-review-table">
          <thead><tr><th>Asset</th><th class="fc-num">ZCHF exposure</th><th>Next review</th></tr></thead>
          <tbody>{review.map(r => <tr><td><a class="font-bold underline" href={`/collateral/${r.slug}`}>{r.ticker}</a><span class="fc-cell-note">{r.category}</span></td><td class="fc-num">{formatCompact(r.debt)}</td><td><a class="font-bold underline" href={r.url}>{r.action} →</a><span class="fc-cell-note">{r.detail}</span></td></tr>)}</tbody>
        </table></div>}
        <details class="mt-4"><summary class="ty-small font-bold cursor-pointer">All assessment findings, including proposals</summary><div class="mt-3"><AttentionList groups={attentionGroups(records, "review")} queue="review" /></div></details>
      </section>
      <details id="data" class="fc-card p-5 scroll-mt-24">
        <summary class="ty-title-3 font-bold cursor-pointer">Data coverage & sources</summary>
        <p class="ty-small my-4">Protocol snapshot {formatDateTime(set?.protocolFetchedAt)}. Current, reconciled price data covers {formatPercent(coverage.sharePct, 1)} of reported debt. Expiry and assessment figures do not depend on market prices.</p>
        <AttentionList groups={attentionGroups(records, "data")} queue="data" />
      </details>
      <details id="live" class="fc-card p-5 scroll-mt-24">
        <summary class="ty-title-3 font-bold cursor-pointer">Position monitoring reference</summary>
        <p class="ty-small my-4">For live position management and auctions, <a href="https://app.frankencoin.com/monitoring" class="underline" target="_blank" rel="noopener noreferrer">open the Frankencoin app ↗</a>. Price findings below use the last observed reference price.</p>
        {(set?.unattributedActiveChallenges ?? 0) > 0 && <p class="fc-notice mb-4">{set!.unattributedActiveChallenges} active challenges have no matching position in the feed. <a href="https://app.frankencoin.com/challenges" class="underline">Inspect challenges ↗</a></p>}
        <AttentionList groups={attentionGroups(records, "live")} queue="live" />
      </details>
    </div>
  </Section>
</Base>
<script>import "@/scripts/detail-navigation";</script>
