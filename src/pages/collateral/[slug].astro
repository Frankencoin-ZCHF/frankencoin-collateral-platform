---
import Base from "@/layouts/Base.astro";
import Section from "@/components/Layout/Section.astro";
import ExecutiveSummary from "@/components/ExecutiveSummary.astro";
import CollateralHeader from "@/components/CollateralHeader.astro";
import AssessmentSources from "@/components/AssessmentSources.astro";
import { config } from "@/config";
import Unavailable from "@/components/Unavailable.astro";
import ui from "@/content/ui.json";
import { SYSTEM_BLOCKS, runBlocks, type BlockContext } from "@/blocks";
import { describeForLog } from "@/lib/errors";
import { isValidSlug, normalizeSha } from "@/lib/slug";
import * as assessments from "@/services/assessments";
import * as collaterals from "@/services/collaterals";
import type { Assessment, VersionRef } from "@/types";

export const prerender = false;

const slug = (Astro.params.slug ?? "").toLowerCase();
if (!isValidSlug(slug)) return Astro.rewrite("/404");

let set: Awaited<ReturnType<typeof collaterals.all>> | null = null;
try {
  set = await collaterals.all();
} catch (e) {
  console.error(`[collateral/${slug}] ${describeForLog(e)}`);
}
const record = set?.records.find((r) => r.slug === slug) ?? null;
if (!record) return Astro.rewrite("/404");

// Versions (best effort) and the requested historical version.
const requestedSha = normalizeSha(Astro.url.searchParams.get("v"));
let versions: VersionRef[] = [];
let assessment: Assessment | null = record.assessment;
let version: VersionRef | null = record.assessment?.ref ?? null;
let isHistorical = false;
let versionError: string | null = null;

if (record.assessment) {
  try {
    versions = await assessments.versions(slug);
    if (requestedSha) {
      const at = await assessments.atVersion(slug, requestedSha);
      assessment = at.assessment;
      version = at.version;
      isHistorical = versions[0]?.sha !== at.version.sha;
    } else if (versions[0]) {
      version = versions[0];
    }
  } catch (e) {
    console.error(`[collateral/${slug}] versions: ${describeForLog(e)}`);
    versionError = requestedSha ? "That version could not be loaded — showing the latest." : null;
  }
}

const ctx: BlockContext = { record, assessment, isHistorical, version, versions, origin: Astro.url.origin };
const results = await runBlocks(SYSTEM_BLOCKS, ctx);

const sections = [
  { id: "assessment", title: "Risk data & lending terms", ids: ["risk-summary", "tail-risks"] },
  {
    id: "position-monitoring",
    title: record.live?.bridge ? "Bridge backing" : "Positions & price exposure",
    ids: ["bridge", "position-safety", "positions", "challenges"],
  },
  { id: "full-assessment", title: "Full assessment", ids: ["narrative", "extra-blocks"] },
  { id: "changes-sources", title: "Changes & sources", ids: ["risk-parameters", "live-protocol", "discussion", "versions"] },
];
const hasNarrative = Boolean(assessment?.body.trim());
const grouped = new Set(sections.flatMap((s) => s.ids));
// New content/system blocks remain discoverable even if they are not explicitly grouped yet.
sections[0]!.ids.push(...results.filter((r) => !grouped.has(r.block.id)).map((r) => r.block.id));
const title = `${record.name} (${record.ticker})`;
const description = assessment
  ? `${record.ticker}: ${record.lifecycle} collateral, ${assessment.status} assessment. Free float ${assessment.data.scores.freeFloat ?? "n/a"}, observed downside ${assessment.data.scores.marketRiskPct ?? "n/a"}%, retained reserve ${assessment.data.params.retainedReservePct ?? "n/a"}%. Live positions, discussion and version history.`
  : `${record.ticker}: ${record.lifecycle} Frankencoin collateral without a risk assessment. Live positions, prices and challenges.`;

Astro.response.headers.set("Cache-Control", isHistorical ? "public, max-age=3600, s-maxage=3600" : "public, max-age=60, s-maxage=60");
---

<Base title={title} description={description} type="article" noindex={isHistorical}>
  <Section variant="accent" pad="xs" width="wide" id="overview">
    <CollateralHeader ctx={ctx} />
    {
      config.protocolFixturesDir && (
        <p class="fc-notice mt-4">Sample protocol snapshot. These figures are not the current protocol state.</p>
      )
    }
    {
      versionError && (
        <div class="mt-4">
          <Unavailable compact message={versionError} />
        </div>
      )
    }
    <ExecutiveSummary ctx={ctx} />
  </Section>

  <Section pad="xxs" width="wide">
    <nav class="fc-view-tabs fc-section-nav" aria-label="Collateral sections">
      <a href="#collateral-executive-summary">Summary</a>
      <a href="#assessment">Risk data & lending terms</a>
      {assessment && <a href="#tail-risks">Tail risks</a>}
      <a href="#position-monitoring">{record.live?.bridge ? "Bridge backing" : "Positions & price exposure"}</a>
      {hasNarrative && <a href="#narrative" class="fc-full-assessment-nav">Full assessment</a>}
      <a href="#changes-sources">Sources & history</a>
    </nav>
    <div class="flex flex-col gap-8 mt-6">
      {
        sections.filter((section) => section.id !== "full-assessment" || results.some((r) => section.ids.includes(r.block.id))).map((section) => (
          <section id={section.id} class="scroll-mt-24" aria-labelledby={`${section.id}-heading`}>
            <h2 id={`${section.id}-heading`} class="ty-title-2 font-bold mb-4">
              {section.title}
            </h2>
            {section.id === "changes-sources" && (
              <div class="fc-card p-5 mb-4">
                <AssessmentSources ctx={ctx} />
              </div>
            )}
            {section.id === "position-monitoring" && !results.some((r) => section.ids.includes(r.block.id)) && (
              <p class="ty-small">No on-chain positions are available for this contract.</p>
            )}
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
              {results
                .filter((r) => section.ids.includes(r.block.id))
                .sort((a, b) => section.ids.indexOf(a.block.id) - section.ids.indexOf(b.block.id))
                .map((r) => {
                  const disclosed = ["risk-parameters", "live-protocol", "discussion", "versions"].includes(r.block.id);
                  return disclosed ? (
                    <details id={r.block.id} class="fc-card p-5 min-w-0 lg:col-span-2 scroll-mt-24">
                      <summary class="ty-title-3 font-bold cursor-pointer">
                        {r.block.id === "live-protocol" ? "All protocol parameters" : r.block.title}
                      </summary>
                      <div class="mt-4">
                        {r.status === "ok" ? (
                          <r.block.Component data={r.data} ctx={ctx} />
                        ) : (
                          <Unavailable message={`${r.block.title}: ${r.error ?? ui.labels.unavailable}`} />
                        )}
                      </div>
                    </details>
                  ) : (
                    <section
                      id={r.block.id}
                      class={`fc-card p-5 min-w-0 scroll-mt-24 ${r.block.span === "half" ? "" : "lg:col-span-2"}`}
                      aria-labelledby={`${r.block.id}-title`}
                    >
                      <h3 id={`${r.block.id}-title`} class="ty-title-3 font-bold mb-4">
                        {r.block.title}
                      </h3>
                      {r.status === "ok" ? (
                        <r.block.Component data={r.data} ctx={ctx} />
                      ) : (
                        <Unavailable message={`${r.block.title}: ${r.error ?? ui.labels.unavailable}`} />
                      )}
                    </section>
                  );
                })}
            </div>
          </section>
        ))
      }
    </div>
  </Section>
</Base>

<script>
  import "@/scripts/charts-loader";
  import "@/scripts/detail-navigation";
</script>
