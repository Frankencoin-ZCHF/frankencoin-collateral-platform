---
import type { RiskSummaryData } from "./index";
import Pill from "@/components/Pill.astro";
import { lendingTerms, formatTerm } from "@/services/lending";
import { formatCompact, formatDate, formatDuration, formatPercent } from "@/lib/numbers";
interface Props { data: RiskSummaryData }
const { data } = Astro.props as Props;
const d = data.data, l = data.live, terms = lendingTerms(l);
const assessed = data.status === "draft" ? "Proposed" : data.status === "deprecated" ? "Archived assessment" : "Assessed";
---
<div class="fc-terms-grid">
  <div>
    <p class="fc-kv-label">Effective annual interest</p>
    <p class="fc-kv-value">{l?.bridge ? "Not applicable" : formatTerm(terms.interest)}</p>
    <p class="fc-kv-unit">{l?.bridge ? "1:1 stablecoin exchange" : "Current rate, adjusted for retained reserve"}</p>
    {d && <p class="fc-assessed-term">{assessed}: <strong>{formatPercent(d.totalCompensationPct)}</strong><span class="fc-cell-note">Total tail-risk compensation per year</span></p>}
  </div>
  <div>
    <p class="fc-kv-label">Retained reserve</p>
    <p class="fc-kv-value">{l?.bridge ? "Not applicable" : formatTerm(terms.reserve, 1)}</p>
    <p class="fc-kv-unit">{l?.bridge ? "No position reserve" : "Current share of gross minted debt"}</p>
    {d && <p class="fc-assessed-term">{assessed}: <strong>{formatPercent(d.params.retainedReservePct, 1)}</strong></p>}
  </div>
  <div>
    <p class="fc-kv-label">Global minting limit</p>
    <p class="fc-kv-value">{terms.limit === null ? "Unavailable" : formatCompact(terms.limit)}<span class="ty-small">{terms.limit === null ? "" : " ZCHF"}</span></p>
    <p class="fc-kv-unit">{l?.bridge ? "Bridge limit" : "Across all originals"}{terms.limitUsedPct !== null && ` · ${formatPercent(terms.limitUsedPct, 1)} used`}</p>
    {d && <p class="fc-assessed-term">{assessed}: <strong>{d.params.globalMintingLimit === null ? "—" : `${formatCompact(d.params.globalMintingLimit)} ZCHF`}</strong></p>}
  </div>
</div>
{l && !l.bridge && <p class="ty-small text-[var(--color-gray-75)] mt-3">
  Effective interest = (base rate + contract premium) ÷ (1 − retained reserve).
  {terms.interest && terms.interest.min !== terms.interest.max && ` Rates vary; average ${formatPercent(terms.interest.average)}, weighted by debt outside the reserve.`}
  {!terms.complete && l.totalMintedZchf > 0 && " Terms cover the available positions; the position feed is incomplete."}
  {d && <a href="#risk-parameters" class="underline">Inspect individual settings →</a>}
</p>}
{d && <div class="fc-kv !grid-cols-2 lg:!grid-cols-4 mt-6">
  <div><p class="fc-kv-label">Free float / liquidity</p><p class="mt-2"><Pill value={d.scores.freeFloat} /></p></div>
  <div><p class="fc-kv-label">Public information</p><p class="mt-2"><Pill value={d.scores.publicInformation} /></p></div>
  <div><p class="fc-kv-label">Observed downside{d.params.auctionDurationHours ? ` · ${d.params.auctionDurationHours * 2}h` : ""}</p><p class="fc-kv-value">{formatPercent(d.scores.marketRiskPct)}</p><p class="fc-kv-unit">Historical measure from the assessment</p></div>
  <div><p class="fc-kv-label">Assessed auction duration</p><p class="fc-kv-value">{d.params.auctionDurationHours === null ? "—" : formatDuration(d.params.auctionDurationHours * 3600)}</p><p class="fc-kv-unit">Used to assess ordinary price risk</p></div>
</div>}
{d && <p class="ty-small text-[var(--color-gray-75)] mt-5">
  {data.status === "draft" ? "Draft" : data.status === "published" ? "Published" : "Archived"} assessment · {formatDate(d.assessmentDate)} · {d.author}
  {data.sourceUrl && <> · <a href={data.sourceUrl} target="_blank" rel="noopener noreferrer" class="underline">Read source ↗</a></>}
</p>}
