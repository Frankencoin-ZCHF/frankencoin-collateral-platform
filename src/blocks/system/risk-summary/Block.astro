---
import type { RiskSummaryData } from "./index";
import Pill from "@/components/Pill.astro";
import { formatDate, formatPercent } from "@/lib/numbers";
interface Props {
  data: RiskSummaryData;
}
const { data } = Astro.props as Props;
const d = data.data;
const worst = [...d.tailRisks].filter((t) => t.compensationPct).sort((a, b) => (b.compensationPct ?? 0) - (a.compensationPct ?? 0)).slice(0, 3);
---

<div class="fc-kv !grid-cols-2">
  <div>
    <p class="fc-kv-label">Free float / liquidity</p>
    <p class="mt-1"><Pill value={d.scores.freeFloat} /></p>
  </div>
  <div>
    <p class="fc-kv-label">Public information</p>
    <p class="mt-1"><Pill value={d.scores.publicInformation} /></p>
  </div>
  <div>
    <p class="fc-kv-label">Observed downside{d.params.auctionDurationHours ? ` · ${d.params.auctionDurationHours * 2} hours` : ""}</p>
    <p class="fc-kv-value">{formatPercent(d.scores.marketRiskPct)}</p>
    <p class="fc-kv-unit">historical drawdown or VaR from the assessment; not a maximum possible future loss</p>
  </div>
  <div>
    <p class="fc-kv-label">Tail-risk compensation</p>
    <p class="fc-kv-value">{formatPercent(d.totalCompensationPct)}</p>
    <p class="fc-kv-unit">sum of all tail-risk premiums per year</p>
  </div>
  <div>
    <p class="fc-kv-label">Assessed retained reserve</p>
    <p class="fc-kv-value">{formatPercent(d.params.retainedReservePct, 1)}</p>
    <p class="fc-kv-unit">author's proposed share of minted ZCHF retained for liquidation outcomes</p>
  </div>
  <div>
    <p class="fc-kv-label">Assessed target premium</p>
    <p class="fc-kv-value">{formatPercent(d.params.targetInterestRatePct)}</p>
    <p class="fc-kv-unit">proposed risk premium above the lead rate</p>
  </div>
</div>

{
  worst.length > 0 && (
    <div class="mt-4">
      <p class="fc-kv-label mb-1">Main assessed residual risks</p>
      <ul class="flex flex-col gap-1">
        {worst.map((t) => (
          <li class="ty-small flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
            <span>{t.name}</span>
            <span class="text-[var(--color-gray-75)] shrink-0">{t.probability ?? "Unrated"} likelihood · {t.severity ?? "unrated"} impact</span>
          </li>
        ))}
      </ul>
    </div>
  )
}

<p class="ty-2xs text-[var(--color-gray-60)] mt-4">
  Assessed {formatDate(d.assessmentDate)} by {d.author} · <a href={data.sourceUrl} target="_blank" rel="noopener noreferrer" class="underline">source ↗</a>
</p>
