---
import type { LiveCollateral } from "@/types";
import Unavailable from "@/components/Unavailable.astro";
import { formatCompact, formatDateTime, formatNumber, formatPercent, formatPrice } from "@/lib/numbers";
interface Props {
  data: LiveCollateral;
}
const { data: l } = Astro.props as Props;
const chg = l.market?.change24hPct ?? null;
const open = l.counts?.open ?? l.positions.active;
const total = l.counts?.total ?? l.positions.total;
---

{l.reconciliation.divergent && <div class="mb-3"><Unavailable compact message={l.reconciliation.note ?? "Position feed and protocol aggregate disagree."} /></div>}

<div class="fc-kv !grid-cols-2 lg:!grid-cols-3">
  <div>
    <p class="fc-kv-label">Oracle price</p>
    <p class="fc-kv-value">{l.price ? `${formatPrice(l.price.chf)} CHF` : "–"}</p>
    <p class="fc-kv-unit">
      {l.price && `$${formatPrice(l.price.usd)}`}
      {chg !== null && <span class={chg >= 0 ? "text-emerald-700" : "text-red-700"}> · {chg >= 0 ? "+" : ""}{formatPercent(chg, 1)} 24h (CoinGecko)</span>}
    </p>
  </div>
  <div>
    <p class="fc-kv-label">Minted ZCHF</p>
    <p class="fc-kv-value">{formatCompact(l.totalMintedZchf)}</p>
    <p class="fc-kv-unit">debt against this collateral</p>
  </div>
  <div>
    <p class="fc-kv-label">Remaining aggregate limit</p>
    <p class="fc-kv-value">{l.remainingLimitZchf === null ? "–" : formatCompact(l.remainingLimitZchf)}</p>
    <p class="fc-kv-unit">{l.totalLimitZchf === null ? "aggregate limit unknown" : `of ${formatCompact(l.totalLimitZchf)} ZCHF total limit`}</p>
  </div>
  <div>
    <p class="fc-kv-label">Oracle-valued collateral</p>
    <p class="fc-kv-value">{l.collateralValueChf === null ? "–" : `${formatCompact(l.collateralValueChf)} CHF`}</p>
    <p class="fc-kv-unit">{formatNumber(l.totalCollateral, l.totalCollateral < 10 ? 4 : 2)} {l.symbol} locked</p>
  </div>
  <div>
    <p class="fc-kv-label">Open positions</p>
    <p class="fc-kv-value">{open}</p>
    <p class="fc-kv-unit">{total} total{l.counts ? ` · ${l.counts.originals} original / ${l.counts.clones} clones` : ""}</p>
  </div>
  <div>
    <p class="fc-kv-label">Utilisation</p>
    <p class="fc-kv-value">{formatPercent(l.utilizationPct, 1)}</p>
    <p class="fc-kv-unit">debt ÷ oracle-valued collateral</p>
  </div>
  <div>
    <p class="fc-kv-label">Live position-weighted premium</p>
    <p class="fc-kv-value">{formatPercent(l.riskPremiumPct?.weightedAvg ?? null)}</p>
    <p class="fc-kv-unit">{l.riskPremiumPct && l.riskPremiumPct.min !== l.riskPremiumPct.max ? `positions range ${formatPercent(l.riskPremiumPct.min)} – ${formatPercent(l.riskPremiumPct.max)}` : "risk premium above the lead rate"}</p>
  </div>
  <div>
    <p class="fc-kv-label">Total borrowing rate</p>
    <p class="fc-kv-value">{formatPercent(l.annualInterestPct?.weightedAvg ?? null)}</p>
    <p class="fc-kv-unit">= lead rate + position premium</p>
  </div>
  <div>
    <p class="fc-kv-label">Challenges</p>
    <p class="fc-kv-value">{l.challenges.active}</p>
    <p class="fc-kv-unit">active · {l.challenges.total} total</p>
  </div>
</div>
<p class="ty-2xs text-[var(--color-gray-60)] mt-4">
  Source: {l.reconciliation.aggregateSource === "stats" ? "protocol aggregate (api.frankencoin.com/ecosystem/collateral/stats)" : "position feed (aggregate endpoint unavailable)"}
  {l.price?.source && ` · price via ${l.price.source}`}{l.price?.timestamp && ` (${formatDateTime(l.price.timestamp)})`}
</p>
