---
import type { RiskParametersData } from "./index";
import { verdictLabel } from "@/services/comparison";
import { formatCompact, shortAddress } from "@/lib/numbers";
interface Props {
  data: RiskParametersData;
}
const { data } = Astro.props;
const baseline =
  data.status === "published" ? "Published assessment" : data.status === "deprecated" ? "Archived assessment" : "Draft proposal";
---

<p class="ty-small mb-3">
  Compare individual observed settings with the author's proposal. Publication does not establish governance approval. A range is shown
  whenever positions use different settings.
</p>
<div class="overflow-x-auto">
  <table class="fc-table">
    <thead><tr><th>Parameter</th><th class="fc-num">{baseline}</th><th class="fc-num">Observed settings</th><th>Comparison</th></tr></thead
    ><tbody
      >{
        data.rows.map((r) => (
          <tr>
            <>
              <td>
                <>
                  <strong>{r.label}</strong>
                  <span class="fc-cell-note">{r.hint}</span>
                </>
              </td>
              <td class="fc-num">{r.assessed}</td>
              <td class="fc-num">{r.onchain}</td>
              <td class="min-w-64">
                <strong class="ty-small">{verdictLabel(r.verdict, data.status)}</strong>
                <span class="fc-cell-note">{r.explanation}</span>
                {r.differentPositions.length > 0 && (
                  <details class="mt-2">
                    <summary class="ty-small underline cursor-pointer">
                      Inspect {r.differentPositions.length} differing positions · {formatCompact(r.differentDebt)} ZCHF
                    </summary>
                    <ul class="mt-2 flex flex-col gap-2">
                      {r.differentPositions.map((p) => (
                        <li class="ty-small">
                          <a href={p.url} target="_blank" rel="noopener noreferrer" class="font-mono underline">
                            {shortAddress(p.address, 5)} ↗
                          </a>{" "}
                          · {p.value} · {formatCompact(p.debt)} ZCHF
                        </li>
                      ))}
                    </ul>
                  </details>
                )}
              </td>
            </>
          </tr>
        ))
      }</tbody>
  </table>
</div>
